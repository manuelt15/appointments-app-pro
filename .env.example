# Copia este fichero a .env.local y rellena los valores.

# MongoDB
MONGODB_URI=mongodb://localhost:27017/appointments-pro

# NextAuth v5
AUTH_SECRET=           # genera con: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth (opcional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (opcional)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# El servidor MCP no lee de aquí: su URL y su api key van en .mcp.json (ver README).
